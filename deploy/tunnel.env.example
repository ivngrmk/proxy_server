# Client-side Bash settings. Copy to .env.tunnel in the project root.
# Values already exported in your shell take precedence over these defaults.
VPS_HOST=${VPS_HOST:-your-vps-host}
VPS_USER=${VPS_USER:-root}
VPS_PORT=${VPS_PORT:-22}

# Leave empty to use ssh-agent or identities from ~/.ssh/config.
SSH_KEY=${SSH_KEY:-}
# Example: SSH_KEY="$HOME/.ssh/id_ed25519"

TUNNEL_HOST=${TUNNEL_HOST:-127.0.0.1}
TUNNEL_PORT=${TUNNEL_PORT:-18181}
VPS_PROXY_BIND_HOST=${VPS_PROXY_BIND_HOST:-127.0.0.1}
VPS_PROXY_BIND_PORT=${VPS_PROXY_BIND_PORT:-18181}

# auto: start when VPS_HOST is set and PROXY_URL points to the local tunnel.
# 1: always start; 0: use an existing proxy without managing SSH.
TUNNEL_AUTO_START=${TUNNEL_AUTO_START:-auto}
SSH_CONNECT_TIMEOUT=${SSH_CONNECT_TIMEOUT:-5}
PROXY_CHECK_URL=${PROXY_CHECK_URL:-https://example.com/}
PROXY_CONNECT_TIMEOUT=${PROXY_CONNECT_TIMEOUT:-5}
PROXY_CHECK_TIMEOUT=${PROXY_CHECK_TIMEOUT:-15}
