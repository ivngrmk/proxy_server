# systemd EnvironmentFile syntax: KEY=value, no shell expansion or export.
PROXY_BIND_HOST=127.0.0.1
PROXY_BIND_PORT=18181
# Keep this path in sync with StateDirectory in the service unit.
PROXY_DIR=/var/lib/proxy-server
PROXY_HEARTBEAT_SECONDS=180
PROXY_MAX_LOG_BYTES=1048576
PROXY_KEEP_LOG_BYTES=262144
